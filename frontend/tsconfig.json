{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "lib": ["DOM", "ES2015", "DOM.Iterable", "ScriptHost"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true // Ensure this is true if you're only type-checking
  },
  "include": ["src"]
}
